# Docker matches per path component, so patterns need **/ to catch nested
# files. Kept in sync with .gitignore.
.git
**/node_modules
**/dist
coverage
docs
datacache
snapshots
scripts
.vscode
.idea
.cursor
.claude/settings.local.json
.claude/scheduled_tasks.lock
.env
cache.sqlite
cache.sqlite-wal
cache.sqlite-shm
**/*.har
**/testout_*
**/temp*.json
**/temp*.js
http-dump.jsonl
output.log
entity-map-viewer.html
opencode.json
VQUEUE_FRAMEWORK_SPEC.md
